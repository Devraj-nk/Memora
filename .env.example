# Copy to .env and adjust as needed. All paths are relative to project root.

# --- LLM (served by Ollama, running locally) ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434

# --- Embeddings (sentence-transformers, downloaded on first run) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Storage ---
VECTOR_STORE_PATH=data/db/vectors.lance
GRAPH_DB_PATH=data/db/graph.sqlite3
OBSERVABILITY_DB_PATH=data/db/observability.sqlite3
RAW_DATA_PATH=data/raw
